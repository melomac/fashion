# UPX's tokens, for the unpack harness (PackMach.swift): the pack header's marker, version, format and method, the
# l_info before the packed data, the segments its packers write, each b_info's method, filter and cto, LZMA's
# properties, the branches the filters undo, and the Mach-O tokens the image is parsed by, which macho.dict holds for
# the other harnesses (libFuzzer takes one dictionary).
upx_magic="UPX!"
upx_marker_modified="VQY\""
# Pack header: "UPX!", version 13 (10 to 13 carry a checksum), the format of each class, a method.
ph_i386_nrv2b="UPX!\x0d\x1d\x02"
ph_i386_dylib_nrv2e="UPX!\x0d\x21\x08"
ph_arm_nrv2e="UPX!\x0d\x20\x08"
ph_x86_64_nrv2b="UPX!\x0d\x22\x02"
ph_x86_64_nrv2d="UPX!\x0d\x22\x05"
ph_x86_64_nrv2e="UPX!\x0d\x22\x08"
ph_x86_64_lzma="UPX!\x0d\x22\x0e"
ph_x86_64_dylib_lzma="UPX!\x0d\x23\x0e"
ph_arm64_nrv2b="UPX!\x0d\x25\x02"
ph_arm64_nrv2e="UPX!\x0d\x25\x08"
ph_arm64_lzma="UPX!\x0d\x25\x0e"
ph_ppc_nrv2b="UPX!\x0d\x83\x02"
ph_ppc_dylib_nrv2e="UPX!\x0d\x8a\x08"
ph_ppc64_nrv2b="UPX!\x0d\x8b\x02"
ph_ppc64_dylib_nrv2e="UPX!\x0d\x8e\x08"
ph_version_8="UPX!\x08"
ph_version_10="UPX!\x0a"
ph_version_12="UPX!\x0c"
ph_version_ff="UPX!\xff"
# l_info: checksum, marker, lsize, version, format.
l_info_x86_64="UPX!\x00\x00\x0d\x22"
l_info_arm64="UPX!\x00\x00\x0d\x25"
l_info_ppc="UPX!\x00\x00\x0d\x83"
# The segments the packers write.
seg_upx_data="UPX_DATA"
seg_xhdr="__XHDR"
seg_text="__TEXT"
seg_linkedit="__LINKEDIT"
# b_info's method, filter and cto, after its two sizes.
b_nrv2b_le32="\x02\x00\x00\x00"
b_nrv2b_8="\x03\x00\x00\x00"
b_nrv2b_le16="\x04\x00\x00\x00"
b_nrv2d_le32="\x05\x00\x00\x00"
b_nrv2d_8="\x06\x00\x00\x00"
b_nrv2d_le16="\x07\x00\x00\x00"
b_nrv2e_le32="\x08\x00\x00\x00"
b_nrv2e_8="\x09\x00\x00\x00"
b_nrv2e_le16="\x0a\x00\x00\x00"
b_lzma="\x0e\x00\x00\x00"
b_nrv2b_ctoj="\x02\x46\x01\x00"
b_nrv2e_ctok="\x08\x49\x01\x00"
b_lzma_ctoj="\x0e\x46\x05\x00"
b_nrv2e_ct24arm="\x08\x50\x00\x00"
b_nrv2e_ct26arm="\x08\x52\x00\x00"
b_lzma_ct26arm="\x0e\x52\x00\x00"
b_lzma_ctarm64="\x0e\x53\x00\x00"
b_nrv2e_ctarm64="\x08\x53\x00\x00"
b_nrv2b_ppcbxx="\x02\xd0\x0b\x00"
b_method_11="\x0b\x00\x00\x00"
b_method_15="\x0f\x00\x00\x00"
# LZMA's two property bytes: lc + lp in the first's high bits, pb below; lp then lc in the second.
lzma_props_default="\x1a\x03"
lzma_props_pb0="\x18\x03"
lzma_props_zero="\x00\x00"
lzma_props_lc8="\x40\x08"
# The branches the filters look for: x86 call and jump with cto, conditional jump, arm BL, arm64 B, BL, B.cond, CBZ, TBZ,
# PowerPC bl.
x86_call="\xe8\x01"
x86_jmp="\xe9\x01"
x86_jcc="\x0f\x85\x01"
arm_bl="\x00\x00\x00\xeb"
arm64_b="\x00\x00\x00\x14"
arm64_bl="\x00\x00\x00\x94"
arm64_b_cond="\x00\x00\x00\x54"
arm64_cbz="\x00\x00\x00\x34"
arm64_cbnz="\x00\x00\x00\xb5"
arm64_tbz="\x00\x00\x00\x36"
arm64_tbnz="\x00\x00\x00\xb7"
ppc_bl="\x4a\xc0\x00\x01"
# Mach-O, for the image around the packed data, and its signature, which the harness removes too.
mh_magic_64="\xcf\xfa\xed\xfe"
mh_cigam_64="\xfe\xed\xfa\xcf"
mh_magic="\xce\xfa\xed\xfe"
mh_cigam="\xfe\xed\xfa\xce"
fat_magic="\xca\xfe\xba\xbe"
fat_magic_64="\xca\xfe\xba\xbf"
lc_segment="\x01\x00\x00\x00"
lc_segment_64="\x19\x00\x00\x00"
lc_code_signature="\x1d\x00\x00\x00"
lc_main="\x28\x00\x00\x80"
lc_build_version="\x32\x00\x00\x00"
cs_embedded_signature="\xfa\xde\x0c\xc0"
cs_code_directory="\xfa\xde\x0c\x02"
